                } from '@taiga-ui/cdk';

                export class TestComponent {
                    protected readonly html: TuiSafeHtml | null = null;
                    protected readonly union: TuiLooseUnion<'a'> | null = null;
                    protected readonly values: TuiValuesOf<
                        Record<string, number>
                    > | null = null;
                    protected readonly letContext: TuiLetContext<unknown> | null = null;
                    protected readonly repeatContext: TuiRepeatTimesContext | null = null;
                    protected readonly error: TuiValuePresentException | null = null;
                }
            ",
  "1. After": "
                import {
// TODO: (Taiga UI migration) TuiLetContext has been removed together with TuiLet. Use Angular's built-in @let syntax.
                    type TuiLetContext,
// TODO: (Taiga UI migration) TuiLooseUnion has been removed. Inline the type where you used it, e.g. \`T | (string & {})\`.
                    type TuiLooseUnion,
// TODO: (Taiga UI migration) TuiRepeatTimesContext has been removed. Use the context of a native @for loop instead.
                    type TuiRepeatTimesContext,
// TODO: (Taiga UI migration) TuiSafeHtml has been removed. Use SafeHtml from @angular/platform-browser (or a plain string) instead.
                    type TuiSafeHtml,
// TODO: (Taiga UI migration) TuiValuePresentException has been removed together with tuiMustBePresent. Handle empty values yourself.
                    type TuiValuePresentException,
// TODO: (Taiga UI migration) TuiValuesOf has been removed. Inline \`T[keyof T]\` where you used it.
                    type TuiValuesOf,
                } from '@taiga-ui/cdk';

                export class TestComponent {
                    protected readonly html: TuiSafeHtml | null = null;
                    protected readonly union: TuiLooseUnion<'a'> | null = null;
                    protected readonly values: TuiValuesOf<
                        Record<string, number>
                    > | null = null;
                    protected readonly letContext: TuiLetContext<unknown> | null = null;
                    protected readonly repeatContext: TuiRepeatTimesContext | null = null;
                    protected readonly error: TuiValuePresentException | null = null;
                }
            ",
}
`;
