exports[`ng-update warn on removed cdk utilities/tokens/types (#11917) warns on removed cdk DOM utilities: test.ts 1`] = `
{
  "0. Before": "
                import {
                    tuiDirectiveListener,
                    tuiGetElementPoint,
                    tuiIsCurrentTarget,
                    tuiIsInsideIframe,
                    tuiIsNodeIn,
                    tuiRetargetedBoundaryCrossing,
                } from '@taiga-ui/cdk';

                export class TestComponent {
                    protected readonly listener = tuiDirectiveListener;
                    protected readonly point = tuiGetElementPoint;
                    protected readonly current = tuiIsCurrentTarget;
                    protected readonly iframe = tuiIsInsideIframe;
                    protected readonly nodeIn = tuiIsNodeIn;
                    protected readonly retarget = tuiRetargetedBoundaryCrossing;
                }
            ",
  "1. After": "
                import {
// TODO: (Taiga UI migration) tuiDirectiveListener has been removed. Use Renderer2.listen() or a host listener instead.
                    tuiDirectiveListener,
// TODO: (Taiga UI migration) tuiGetElementPoint has been removed. Read coordinates from Element.getBoundingClientRect() instead.
                    tuiGetElementPoint,
// TODO: (Taiga UI migration) tuiIsCurrentTarget has been removed. Compare event.target === event.currentTarget inline.
                    tuiIsCurrentTarget,
// TODO: (Taiga UI migration) tuiIsInsideIframe has been removed. Check window.self !== window.top inline.
                    tuiIsInsideIframe,
// TODO: (Taiga UI migration) tuiIsNodeIn has been removed. Use Node.contains() inline.
                    tuiIsNodeIn,
// TODO: (Taiga UI migration) tuiRetargetedBoundaryCrossing has been removed with no direct replacement; inline the boundary-crossing logic if you relied on it.
                    tuiRetargetedBoundaryCrossing,
                } from '@taiga-ui/cdk';

                export class TestComponent {
                    protected readonly listener = tuiDirectiveListener;
                    protected readonly point = tuiGetElementPoint;
                    protected readonly current = tuiIsCurrentTarget;
                    protected readonly iframe = tuiIsInsideIframe;
                    protected readonly nodeIn = tuiIsNodeIn;
                    protected readonly retarget = tuiRetargetedBoundaryCrossing;
                }
            ",
}
`;

