// TODO: (Taiga UI migration) TuiSidebarComponent has been removed. Use TuiDrawer from @taiga-ui/kit together with TuiPopup from @taiga-ui/core instead.
                    TuiSidebarComponent,
// TODO: (Taiga UI migration) TuiSidebarDirective has been removed. Use TuiDrawer from @taiga-ui/kit together with TuiPopup from @taiga-ui/core instead.
                    TuiSidebarDirective,
// TODO: (Taiga UI migration) tuiFindTouchIndex has been removed. Read TouchEvent.changedTouches directly to find the relevant touch point.
                    tuiFindTouchIndex,
                } from '@taiga-ui/addon-mobile';

                @Component({
                    imports: [TuiSidebarComponent, TuiSidebarDirective],
                })
                export class TestComponent {
                    protected readonly find = tuiFindTouchIndex;
                }
            ",
}
`;

exports[`ng-update leftover removed symbols warnings (#11917) adds TODO comments for removed @taiga-ui/core symbols: test.ts 1`] = `
{
  "0. Before": "
                import {Component, inject} from '@angular/core';
                import {
                    TUI_DATA_LIST_ACCESSOR,
                    TUI_HINT_PROVIDERS,
                    TUI_THEME,
                    TuiDataListDirective,
                    tuiAsDataList,
                    tuiAsDataListAccessor,
                } from '@taiga-ui/core';

                @Component({
                    providers: [TUI_HINT_PROVIDERS],
                })
                export class TestComponent {
                    protected readonly theme = inject(TUI_THEME);
                    protected readonly accessor = inject(TUI_DATA_LIST_ACCESSOR);
                    protected readonly as = [
                        tuiAsDataList,
                        tuiAsDataListAccessor,
                        TuiDataListDirective,
                    ];
                }
            ",
  "1. After": "
                import {Component, inject} from '@angular/core';
                import {
// TODO: (Taiga UI migration) TUI_DATA_LIST_ACCESSOR has been removed. It exposed the option list; TUI_DATA_LIST_HOST is a different entity (it receives the selected value), so it is NOT a drop-in replacement. Obtain the accessor from the <tui-data-list> component, which implements TuiDataListAccessor.
                    TUI_DATA_LIST_ACCESSOR,
// TODO: (Taiga UI migration) TUI_HINT_PROVIDERS has been removed. Use the tuiGetHintProviders() function from @taiga-ui/core instead.
                    TUI_HINT_PROVIDERS,
// TODO: (Taiga UI migration) TUI_THEME has been removed from @taiga-ui/core. There is no DI token for the theme anymore. Set it via the tuiTheme HTML attribute on a container element (e.g. document.body.setAttribute('tuiTheme', 'dark'), or tuiTheme="dark" in a template); components resolve the nearest [tuiTheme] ancestor.
                    TUI_THEME,
// TODO: (Taiga UI migration) TuiDataListDirective has been removed. Use TuiDataList from @taiga-ui/core instead.
                    TuiDataListDirective,
// TODO: (Taiga UI migration) tuiAsDataList has been removed. tuiAsDataListHost is a different concept (it registers a value host, not an option-list accessor), so it is NOT a drop-in replacement. The <tui-data-list> component now provides the accessor itself.
                    tuiAsDataList,
// TODO: (Taiga UI migration) tuiAsDataListAccessor has been removed. tuiAsDataListHost is a different concept (value host, not option-list accessor) and is NOT a drop-in replacement. The <tui-data-list> component now provides the accessor itself.
                    tuiAsDataListAccessor,
                } from '@taiga-ui/core';

                @Component({
                    providers: [TUI_HINT_PROVIDERS],
                })
                export class TestComponent {
                    protected readonly theme = inject(TUI_THEME);
                    protected readonly accessor = inject(TUI_DATA_LIST_ACCESSOR);
                    protected readonly as = [
                        tuiAsDataList,
                        tuiAsDataListAccessor,
                        TuiDataListDirective,
                    ];
                }
            ",
}
`;

